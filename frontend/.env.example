# Default: offline emulator (python -m backend.local.emulator). Nothing to set.
# VITE_MODE=local

# AWS deployment: copy to .env.local and fill in from `terraform output`
# VITE_MODE=aws
# VITE_API_URL=https://xxxxxxxx.execute-api.ap-south-1.amazonaws.com
# VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_AWS_REGION=ap-south-1
