# Offline emulator (npm run dev / npm run build): nothing to configure.

# AWS deployment (npm run dev:aws / npm run build:aws) reads frontend/.env.aws.local.
# Create it from Terraform instead of copying this by hand:
#   terraform -chdir=../infrastructure/terraform output -raw frontend_env > .env.aws.local
#
# VITE_API_URL=https://xxxxxxxx.execute-api.ap-south-1.amazonaws.com
# VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_AWS_REGION=ap-south-1
